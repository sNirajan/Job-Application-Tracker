PORT=3001
NODE_ENV=development

# Development / test database (matches docker-compose)
DB_HOST=localhost
DB_PORT=5433
DB_USER=tracker
DB_PASSWORD=tracker123
DB_NAME=job_tracker

# Production database (only used when NODE_ENV=production)
DATABASE_URL=

REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=access-secret-change-this
JWT_REFRESH_SECRET=refresh-secret-change-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Uploaded documents: "local" (disk, ./uploads) for development,
# "s3" in production (uses the ECS task role, no keys needed)
STORAGE_DRIVER=local
S3_BUCKET=
AWS_REGION=us-east-2
